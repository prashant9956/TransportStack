
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#101a32">
    <title>Delhi Journey Planner | TransportStack</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --navy: #101a32;
            --navy2: #172746;
            --blue: #4169f5;
            --blue2: #6385ff;
            --bg: #f4f6fb;
            --text: #17233d;
            --muted: #8490a5;
            --border: #e8edf5;
            --green: #159b67;
            --orange: #d88b32;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
        }

        button, input, select { font-family: inherit; }

        /* NAVBAR */

        .navbar {
            background: #101a32;
            padding: 15px 0;
            border-bottom: 1px solid #ffffff12;
        }

        .brand {
            color: white;
            font-size: 22px;
            font-weight: 900;
            letter-spacing: -.9px;
            text-decoration: none;
        }

        .brand span { color: #78a0ff; }

        .nav-link {
            color: #b9c6dc !important;
            font-size: 12px;
            font-weight: 700;
            padding: 10px 15px !important;
            border-radius: 9px;
            transition: .2s;
        }

        .nav-link:hover,
        .nav-link.active {
            color: white !important;
            background: #ffffff12;
        }

        .navbar-toggler {
            border: 1px solid #ffffff30;
            padding: 7px 10px;
        }

        /* HERO */

        .hero {
            position: relative;
            overflow: hidden;
            padding: 70px 0 115px;
            color: white;
            background:
                radial-gradient(circle at 82% 15%, #4169f568, transparent 30%),
                radial-gradient(circle at 5% 100%, #4169f540, transparent 35%),
                linear-gradient(120deg, #0d172d, #1b3567 75%, #203d78);
        }

        .hero:before,
        .hero:after {
            content: "";
            position: absolute;
            border: 1px solid #ffffff12;
            border-radius: 50%;
            pointer-events: none;
        }

        .hero:before {
            width: 430px;
            height: 430px;
            right: -120px;
            top: -210px;
            box-shadow: 0 0 0 45px #ffffff06,
                        0 0 0 90px #ffffff04;
        }

        .hero:after {
            width: 230px;
            height: 230px;
            right: 20%;
            bottom: -170px;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #c5d7ff;
            background: #ffffff10;
            border: 1px solid #ffffff25;
            border-radius: 30px;
            padding: 9px 15px;
            font-size: 10px;
            font-weight: 900;
            letter-spacing: 1.2px;
        }

        .hero-tag i { color: #8eb1ff; font-size: 14px; }

        .hero h1 {
            max-width: 750px;
            margin: 22px 0 15px;
            font-size: clamp(34px, 5vw, 55px);
            line-height: 1.12;
            letter-spacing: -2.5px;
            font-weight: 900;
        }

        .hero-highlight {
            color: #91b4ff;
        }

        .hero p {
            max-width: 590px;
            color: #c1cde3;
            font-size: 14px;
            line-height: 1.9;
            margin: 0;
        }

        .hero-points {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
            margin-top: 25px;
        }

        .hero-point {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #d8e2f5;
            font-size: 11px;
            font-weight: 700;
        }

        .hero-point i { color: #83aaff; font-size: 15px; }

        /* SEARCH PANEL */

        .search-wrap {
            position: relative;
            z-index: 5;
            margin-top: -66px;
        }

        .search-panel {
            background: white;
            border: 1px solid #e7ebf4;
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 22px 65px #17274618;
        }

        .search-heading {
            display: flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 23px;
        }

        .search-heading-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            color: var(--blue);
            background: #edf2ff;
            font-size: 19px;
        }

        .search-heading h5 {
            font-size: 16px;
            font-weight: 900;
            margin: 0 0 4px;
        }

        .search-heading p {
            font-size: 11px;
            color: var(--muted);
            margin: 0;
        }

        .field-label {
            font-size: 10px;
            color: #75829a;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: .8px;
            margin-bottom: 9px;
        }

        .input-wrap { position: relative; }

        .search-input {
            width: 100%;
            height: 53px;
            border: 1px solid #e3e9f3;
            background: #f9faff;
            border-radius: 11px;
            padding: 0 15px;
            outline: none;
            color: var(--text);
            font-size: 12px;
            font-weight: 700;
            transition: .2s;
        }

        .search-input:focus {
            background: white;
            border-color: var(--blue);
            box-shadow: 0 0 0 4px #4169f514;
        }

        .search-input::placeholder {
            color: #a5afbf;
            font-weight: 500;
        }

        .search-btn {
            width: 100%;
            height: 53px;
            border: 0;
            border-radius: 11px;
            color: white;
            font-size: 12px;
            font-weight: 900;
            background: linear-gradient(110deg, #5278ff, #3156d8);
            box-shadow: 0 8px 20px #4169f535;
            transition: .2s;
        }

        .search-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px #4169f548;
        }

        .search-btn:disabled {
            opacity: .65;
            transform: none;
        }

        .suggestions {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            z-index: 50;
            margin-top: 6px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 15px 35px #17274620;
            max-height: 240px;
            overflow-y: auto;
            display: none;
        }

        .suggestion {
            width: 100%;
            border: 0;
            background: white;
            text-align: left;
            padding: 13px 15px;
            border-bottom: 1px solid #f0f2f7;
            font-size: 12px;
            font-weight: 800;
            color: var(--text);
        }

        .suggestion:hover { background: #f3f6ff; }

        .suggestion small {
            display: block;
            color: var(--muted);
            font-size: 10px;
            font-weight: 500;
            margin-top: 4px;
        }

        .error {
            display: none;
            padding: 12px 14px;
            margin-top: 14px;
            background: #fff0f1;
            border: 1px solid #ffd8dc;
            color: #b73542;
            border-radius: 9px;
            font-size: 12px;
        }

        /* MAIN CONTENT */

        .content-area { padding: 48px 0 80px; }

        .eyebrow {
            color: var(--blue);
            font-size: 10px;
            letter-spacing: 1.3px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .section-heading {
            font-size: 24px;
            font-weight: 900;
            letter-spacing: -.8px;
        }

        .muted { color: var(--muted); }

        /* STATS */

        .stat-card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 19px;
            height: 100%;
            transition: .2s;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px #17274610;
        }

        .stat-icon {
            width: 39px;
            height: 39px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: #edf2ff;
            color: var(--blue);
            font-size: 18px;
            margin-bottom: 15px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 900;
            letter-spacing: -.8px;
        }

        .stat-label {
            color: var(--muted);
            font-size: 11px;
            font-weight: 700;
            margin-top: 4px;
        }

        /* INFO */

        .live-info {
            display: flex;
            align-items: flex-start;
            gap: 11px;
            background: #edf3ff;
            border: 1px solid #dce7ff;
            color: #405b98;
            padding: 13px 15px;
            border-radius: 11px;
            font-size: 10px;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        /* FILTERS */

        .filter-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 9px;
            margin: 26px 0 19px;
        }

        .filter-btn {
            background: white;
            border: 1px solid var(--border);
            color: #68758d;
            border-radius: 9px;
            padding: 10px 15px;
            font-size: 11px;
            font-weight: 800;
            transition: .2s;
        }

        .filter-btn:hover { border-color: #c9d7ff; }

        .filter-btn.active {
            background: #edf2ff;
            border-color: #c9d7ff;
            color: #315bd6;
        }

        #sortSelect {
            border: 1px solid var(--border);
            border-radius: 9px;
            padding: 10px 32px 10px 13px;
            font-size: 11px;
            font-weight: 700;
            color: #526078;
            background-color: white;
        }

        /* JOURNEY CARDS */

        .journey-card {
            background: white;
            border: 1px solid #e8edf5;
            border-radius: 17px;
            overflow: hidden;
            margin-bottom: 17px;
            transition: .22s;
        }

        .journey-card:hover {
            border-color: #d2dcf6;
            box-shadow: 0 15px 35px #17274610;
            transform: translateY(-2px);
        }

        .card-main { padding: 23px; }

        .journey-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 25px;
        }

        .journey-badge {
            display: inline-flex;
            align-items: center;
            border-radius: 7px;
            padding: 7px 10px;
            font-size: 9px;
            letter-spacing: .6px;
            font-weight: 900;
        }

        .direct-badge { background: #e7f8ef; color: #168451; }
        .one-badge { background: #edf2ff; color: #315bd6; }
        .two-badge { background: #fff2e4; color: #b86b1c; }

        .route-name {
            font-size: 14px;
            font-weight: 900;
            margin-top: 10px;
        }

        .time-value {
            font-size: 25px;
            font-weight: 900;
            letter-spacing: -.8px;
            color: #17233d;
        }

        .duration {
            font-size: 10px;
            color: var(--muted);
            font-weight: 600;
        }

        .total-time {
            background: #f3f6ff;
            border: 1px solid #e7edff;
            border-radius: 12px;
            padding: 12px 15px;
            text-align: right;
        }

        .total-time .time-value {
            font-size: 21px;
            color: #315bd6;
        }

        .route-point {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            background: var(--blue);
            flex-shrink: 0;
            box-shadow: 0 0 0 4px #4169f51a;
        }

        .route-point.end {
            background: var(--green);
            box-shadow: 0 0 0 4px #159b671a;
        }

        .route-line {
            height: 2px;
            flex: 1;
            position: relative;
            margin: 0 13px;
            background: linear-gradient(90deg, #4169f5, #b6c5ef);
        }

        .route-line:after {
            content: "";
            position: absolute;
            right: 0;
            top: -4px;
            border: 5px solid transparent;
            border-left-color: #91a8e8;
        }

        .action-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 23px;
            padding-top: 17px;
            border-top: 1px solid #f0f2f7;
        }

        .detail-btn,
        .map-btn {
            border-radius: 9px;
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 900;
            transition: .2s;
        }

        .detail-btn {
            background: white;
            border: 1px solid var(--border);
            color: #4c5d7b;
        }

        .detail-btn:hover { background: #f7f9ff; }

        .map-btn {
            border: 0;
            color: white;
            background: linear-gradient(110deg, #4169f5, #3156d8);
            box-shadow: 0 5px 13px #4169f526;
        }

        .map-btn:hover {
            background: #294fcf;
            transform: translateY(-1px);
        }

        /* JOURNEY DETAILS */

        .journey-details {
            display: none;
            padding: 24px;
            background: #f8faff;
            border-top: 1px solid var(--border);
        }

        .journey-details.open { display: block; }

        .details-heading {
            font-size: 11px;
            letter-spacing: .8px;
            font-weight: 900;
            margin-bottom: 18px;
        }

        .leg {
            border-left: 2px solid #cfdbf5;
            padding: 0 0 25px 20px;
            margin-left: 5px;
            position: relative;
        }

        .leg:before {
            content: "";
            position: absolute;
            left: -6px;
            top: 2px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--blue);
            box-shadow: 0 0 0 4px #4169f51a;
        }

        .leg:last-child { border-left-color: transparent; }

        .leg-title {
            font-size: 13px;
            font-weight: 900;
            margin-bottom: 9px;
        }

        .leg-meta {
            font-size: 11px;
            color: #69768d;
            line-height: 2;
        }

        .leg-meta strong { color: #263650; }

        .transfer-note {
            display: inline-block;
            color: #a8671e;
            background: #fff3e3;
            border: 1px solid #ffe8c9;
            padding: 9px 12px;
            border-radius: 8px;
            font-size: 10px;
            margin: 0 0 17px 20px;
            line-height: 1.8;
        }

        /* LIVE STATUS */

        .live-status {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            background: white;
            border: 1px solid #e8edf5;
            border-radius: 11px;
            padding: 12px 14px;
            margin-top: 13px;
        }

        .live-status-title {
            font-size: 10px;
            font-weight: 900;
            color: #4d5b73;
        }

        .live-status-detail {
            font-size: 10px;
            color: var(--muted);
            margin-top: 4px;
        }

        .live-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            border-radius: 30px;
            padding: 6px 9px;
            font-size: 9px;
            font-weight: 900;
        }

        .live-pill:before {
            content: "";
            width: 6px;
            height: 6px;
            background: currentColor;
            border-radius: 50%;
        }

        .live-yes { background: #e8f8ef; color: #168451; }
        .live-no { background: #fff0f1; color: #c13e4b; }
        .live-pending { background: #edf2ff; color: #4169d9; }
        .live-warning { background: #fff4e5; color: #b87322; }

        /* ALTERNATIVES */

        .alternative {
            background: white;
            border: 1px solid var(--border);
            border-radius: 11px;
            padding: 14px;
            margin-top: 10px;
        }

        .alternative strong { font-size: 12px; }

        .alternative small {
            display: block;
            color: var(--muted);
            font-size: 10px;
            margin-top: 6px;
        }

        /* EMPTY + LOADING */

        .empty-state {
            background: white;
            border: 1px solid var(--border);
            border-radius: 17px;
            padding: 65px 20px;
            text-align: center;
        }

        .empty-icon {
            display: grid;
            place-items: center;
            width: 70px;
            height: 70px;
            border-radius: 20px;
            background: #edf2ff;
            color: var(--blue);
            margin: 0 auto 19px;
            font-size: 30px;
        }

        .empty-state h5 {
            font-weight: 900;
            font-size: 17px;
        }

        .empty-state p {
            font-size: 12px;
            line-height: 1.8;
        }

        .loader {
            text-align: center;
            padding: 60px 20px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 17px;
            color: var(--muted);
            font-size: 12px;
        }

        /* FOOTER */

        .footer {
            background: #101a32;
            color: #aab8d0;
            padding: 27px 0;
            font-size: 11px;
        }

        .footer strong { color: white; }

        /* RESPONSIVE */

        @media(max-width: 767px) {
            .hero { padding: 48px 0 95px; }
            .hero h1 {
                font-size: 37px;
                letter-spacing: -1.6px;
            }

            .hero p { font-size: 12px; }
            .hero-points { gap: 12px; }

            .search-wrap { margin-top: -55px; }
            .search-panel {
                padding: 19px;
                border-radius: 16px;
            }

            .content-area { padding-top: 35px; }
            .section-heading { font-size: 21px; }

            .stat-card { padding: 14px; }
            .stat-value { font-size: 24px; }

            .card-main { padding: 17px; }
            .journey-details { padding: 18px; }

            .time-value { font-size: 20px; }
            .total-time .time-value { font-size: 18px; }

            .filter-row { gap: 6px; }
            .filter-btn { padding: 9px 10px; }

            #sortSelect {
                width: 100% !important;
                margin: 5px 0 0 !important;
            }

            .action-row { align-items: stretch; }
            .action-row > div { width: 100%; }
            .action-row button { flex: 1; }

            .footer .container {
                text-align: center;
                justify-content: center !important;
            }
        }

        @media(max-width: 380px) {
            .hero h1 { font-size: 32px; }
            .time-value { font-size: 18px; }
            .journey-top { gap: 6px; }
            .total-time { padding: 9px; }
        }
    </style>
</head>

<body>

<nav class="navbar navbar-expand-lg">
    <div class="container">
        <a class="brand" href="/">TransportStack<span>.</span></a>

        <button class="navbar-toggler bg-light" type="button"
            data-bs-toggle="collapse" data-bs-target="#navMenu"
            aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMenu">
            <div class="navbar-nav ms-auto gap-lg-2">
                <a class="nav-link active" href="/journey-planner">
                    <i class="bi bi-signpost-2 me-1"></i> Journey Planner
                </a>
                <a class="nav-link" href="/live-map">
                    <i class="bi bi-map me-1"></i> Live Map
                </a>
                <a class="nav-link" href="/nearest-stops">
                    <i class="bi bi-geo-alt me-1"></i> Nearest Stops
                </a>
            </div>
        </div>
    </div>
</nav>

<!-- HERO -->

<section class="hero">
    <div class="container hero-content">

        <div class="hero-tag">
            <i class="bi bi-stars"></i>
            DELHI PUBLIC TRANSPORT
        </div>

        <h1>
            Every Delhi journey,
            <span class="hero-highlight">planned smarter.</span>
        </h1>

        <p>
            Explore Delhi's public bus network with intelligent journey planning,
            convenient transfers and real-time fleet information.
            Find a smarter way to reach your destination.
        </p>

        <div class="hero-points">
            <div class="hero-point">
                <i class="bi bi-bus-front"></i>
                Bus route discovery
            </div>
            <div class="hero-point">
                <i class="bi bi-arrow-left-right"></i>
                Smart transfers
            </div>
            <div class="hero-point">
                <i class="bi bi-broadcast"></i>
                Live fleet insights
            </div>
        </div>

    </div>
</section>

<!-- SEARCH -->

<div class="container search-wrap">
    <div class="search-panel">

        <div class="search-heading">
            <div class="search-heading-icon">
                <i class="bi bi-signpost-split"></i>
            </div>
            <div>
                <h5>Plan your journey</h5>
                <p>Choose your starting stop and destination in Delhi</p>
            </div>
        </div>

        <form id="searchForm">
            <div class="row g-3 align-items-end">

                <div class="col-lg-3 col-md-6">
                    <div class="field-label">
                        <i class="bi bi-geo-alt me-1"></i> Starting point
                    </div>
                    <div class="input-wrap">
                        <input id="fromInput" class="search-input"
                            placeholder="Search starting stop..."
                            autocomplete="off" required>
                        <div id="fromSuggestions" class="suggestions"></div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="field-label">
                        <i class="bi bi-geo me-1"></i> Destination
                    </div>
                    <div class="input-wrap">
                        <input id="toInput" class="search-input"
                            placeholder="Where do you want to go?"
                            autocomplete="off" required>
                        <div id="toSuggestions" class="suggestions"></div>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <div class="field-label">
                        <i class="bi bi-calendar3 me-1"></i> Travel date
                    </div>
                    <input type="date" id="travelDate"
                        class="search-input" required>
                </div>

                <div class="col-lg-3 col-md-6">
                    <button type="submit" class="search-btn" id="searchButton">
                        Find my journey <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>

            </div>

            <div class="error" id="searchError"></div>
        </form>

    </div>
</div>

<!-- RESULTS -->

<main class="container content-area">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-4">
        <div>
            <div class="eyebrow mb-2">DELHI ROUTE DISCOVERY</div>
            <div class="section-heading">Find your best journey</div>
            <div class="muted small mt-2" id="resultSubtitle">
                Search between two Delhi stops to explore available bus journeys.
            </div>
        </div>
        <div class="small muted fw-bold" id="resultCount"></div>
    </div>

    <!-- STATS -->

    <div class="row g-3 mb-4" id="stats" style="display:none">

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-bus-front"></i></div>
                <div class="stat-value" id="directCount">0</div>
                <div class="stat-label">Direct journeys</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div>
                <div class="stat-value" id="oneCount">0</div>
                <div class="stat-label">1-transfer journeys</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-signpost-split"></i></div>
                <div class="stat-value" id="twoCount">0</div>
                <div class="stat-label">2-transfer journeys</div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-icon"><i class="bi bi-stars"></i></div>
                <div class="stat-value" id="shownCount">0</div>
                <div class="stat-label">Ranked options</div>
            </div>
        </div>

    </div>

    <!-- LIVE INFO -->

    <div class="live-info" id="liveInfo" style="display:none">
        <i class="bi bi-info-circle-fill"></i>
        <span>
            Live status checks are based on current route GPS data.
            A vehicle on the same route is not automatically treated as your
            scheduled bus. Exact scheduled-trip compatibility is checked separately.
        </span>
    </div>

    <!-- FILTERS -->

    <div class="filter-row" id="filters" style="display:none">

        <button class="filter-btn active" data-filter="all">
            <i class="bi bi-grid me-1"></i> All journeys
        </button>

        <button class="filter-btn" data-filter="0">Direct</button>
        <button class="filter-btn" data-filter="1">1 Transfer</button>
        <button class="filter-btn" data-filter="2">2 Transfers</button>

        <select id="sortSelect" class="form-select form-select-sm ms-md-auto"
            style="width:auto;min-width:155px">
            <option value="fastest">Sort: Fastest</option>
            <option value="easiest">Sort: Easiest</option>
        </select>

    </div>

    <!-- JOURNEY RESULTS -->

    <div id="journeyResults">
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-bus-front"></i>
            </div>
            <h5>Your Delhi journey starts here</h5>
            <p class="muted mb-0">
                Select your starting stop and destination to discover
                direct buses and smart transfer options.
            </p>
        </div>
    </div>

</main>

<footer class="footer">
    <div class="container d-flex justify-content-between flex-wrap gap-2">
        <span>
            <strong>TransportStack.</strong>
            Intelligent mobility for Delhi
        </span>
        <span>Plan better. Travel smarter.</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const fromInput = document.getElementById("fromInput");
    const toInput = document.getElementById("toInput");
    const travelDate = document.getElementById("travelDate");
    const searchForm = document.getElementById("searchForm");

    let selectedFrom = null;
    let selectedTo = null;
    let allJourneys = [];
    let currentFilter = "all";
    let currentSort = "fastest";
    let searchTimers = {};
    let currentRenderedJourneys = [];

    let routeLiveCache = {};

    const now = new Date();

    travelDate.value = [
        now.getFullYear(),
        String(now.getMonth() + 1).padStart(2, "0"),
        String(now.getDate()).padStart(2, "0")
    ].join("-");

    function escapeHTML(value) {
        return String(value ?? "").replace(/[&<>"']/g, char => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#039;"
        })[char]);
    }

    function normalizeText(value) {
        return String(value || "").trim().toLowerCase();
    }

    function setupAutocomplete(input, dropdown, setter) {
        input.addEventListener("input", () => {
            setter(null);
            clearTimeout(searchTimers[input.id]);

            const query = input.value.trim();

            if (query.length < 2) {
                dropdown.style.display = "none";
                return;
            }

            searchTimers[input.id] = setTimeout(async () => {
                try {
                    const response = await fetch(
                        "/api/routes/stops?search=" + encodeURIComponent(query)
                    );

                    const result = await response.json();
                    dropdown.innerHTML = "";

                    if (!result.success || !result.data?.length) {
                        dropdown.innerHTML =
                            '<div class="p-3 small muted">No stops found</div>';
                        dropdown.style.display = "block";
                        return;
                    }

                    result.data.forEach(stop => {
                        const button = document.createElement("button");
                        button.type = "button";
                        button.className = "suggestion";

                        const name = document.createElement("span");
                        name.textContent = stop.stopName;

                        const id = document.createElement("small");
                        id.textContent = "Stop ID: " + stop.stopId;

                        button.append(name, id);

                        button.addEventListener("click", () => {
                            input.value = stop.stopName;
                            setter(stop);
                            dropdown.style.display = "none";
                        });

                        dropdown.appendChild(button);
                    });

                    dropdown.style.display = "block";

                } catch (error) {
                    console.error("Stop search error:", error);
                }
            }, 300);
        });

        document.addEventListener("click", event => {
            if (!input.contains(event.target) &&
                !dropdown.contains(event.target)) {
                dropdown.style.display = "none";
            }
        });
    }

    setupAutocomplete(
        fromInput,
        document.getElementById("fromSuggestions"),
        value => selectedFrom = value
    );

    setupAutocomplete(
        toInput,
        document.getElementById("toSuggestions"),
        value => selectedTo = value
    );

    searchForm.addEventListener("submit", async event => {
        event.preventDefault();

        const errorBox = document.getElementById("searchError");
        errorBox.style.display = "none";

        if (!selectedFrom || !selectedTo) {
            errorBox.textContent =
                "Please select both stops from the autocomplete suggestions.";
            errorBox.style.display = "block";
            return;
        }

        if (String(selectedFrom.stopId) === String(selectedTo.stopId)) {
            errorBox.textContent =
                "Starting stop and destination cannot be the same.";
            errorBox.style.display = "block";
            return;
        }

        if (!travelDate.value) {
            errorBox.textContent = "Please select a travel date.";
            errorBox.style.display = "block";
            return;
        }

        await searchJourneys();
    });

    async function searchJourneys() {
        const button = document.getElementById("searchButton");
        const results = document.getElementById("journeyResults");

        button.disabled = true;
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Searching...';

        results.innerHTML = `
            <div class="loader">
                <div class="spinner-border text-primary mb-3"></div>
                <div class="fw-bold">Finding your best journeys...</div>
                <div class="small mt-2">Checking available routes and transfers</div>
            </div>
        `;

        try {
            const params = new URLSearchParams({
                from: selectedFrom.stopId,
                to: selectedTo.stopId,
                date: travelDate.value
            });

            const response = await fetch("/api/routes/journey?" + params);
            const data = await response.json();

            if (!response.ok || !data.success) {
                throw new Error(data.message || "Journey search failed.");
            }

            allJourneys = data.journeys || [];
            currentFilter = "all";
            currentSort = "fastest";
            routeLiveCache = {};

            document.getElementById("sortSelect").value = "fastest";

            document.querySelectorAll(".filter-btn").forEach(btn => {
                btn.classList.toggle("active", btn.dataset.filter === "all");
            });

            document.getElementById("filters").style.display = "flex";

            document.getElementById("directCount").textContent =
                data.journeyTypes?.direct ?? 0;

            document.getElementById("oneCount").textContent =
                data.journeyTypes?.oneTransfer ?? 0;

            document.getElementById("twoCount").textContent =
                data.journeyTypes?.twoTransfer ?? 0;

            document.getElementById("shownCount").textContent =
                allJourneys.length;

            document.getElementById("stats").style.display = "flex";
            document.getElementById("liveInfo").style.display = "flex";

            document.getElementById("resultSubtitle").textContent =
                selectedFrom.stopName + " → " + selectedTo.stopName +
                " · " + travelDate.value;

            document.getElementById("resultCount").textContent =
                allJourneys.length + " journey options";

            renderJourneys();

            await loadLiveStatusForJourneys();

        } catch (error) {
            results.innerHTML = `
                <div class="empty-state">
                    <div class="empty-icon">⚠️</div>
                    <h5>Unable to find journeys</h5>
                    <p class="muted mb-0">${escapeHTML(error.message)}</p>
                </div>
            `;

            console.error(error);

        } finally {
            button.disabled = false;
            button.innerHTML = 'Find my journey <i class="bi bi-arrow-right ms-1"></i>';
        }
    }

    async function loadLiveStatusForJourneys() {
        const routeIds = [
            ...new Set(
                allJourneys.flatMap(journey =>
                    (journey.legs || [])
                        .map(leg => String(leg.routeId || "").trim())
                        .filter(Boolean)
                )
            )
        ];

        routeIds.forEach(routeId => {
            routeLiveCache[routeId] = { loading: true };
        });

        renderJourneys();

        await Promise.all(routeIds.map(async routeId => {
            try {
                const response = await fetch(
                    "/api/realtime/vehicles/route/" +
                    encodeURIComponent(routeId) + "/progress"
                );

                if (!response.ok) {
                    throw new Error("Live status request failed");
                }

                const data = await response.json();

                if (!data.success) {
                    throw new Error(data.message || "Live data unavailable");
                }

                const vehicles = Array.isArray(data.vehicles)
                    ? data.vehicles
                    : [];

                const freshVehicles = vehicles.filter(vehicle =>
                    vehicle.dataStatus === "live" &&
                    vehicle.isStale !== true
                );

                const exactScheduled = freshVehicles.filter(vehicle =>
                    Number(vehicle.scheduleRelationship) === 0 &&
                    vehicle.routeProgress?.staticTripMatch === true
                );

                routeLiveCache[routeId] = {
                    loading: false,
                    totalVehicles: vehicles.length,
                    liveVehicles: freshVehicles.length,
                    exactScheduledCount: exactScheduled.length,
                    vehicles: freshVehicles,
                    matchedVehicles: data.matchedVehicles ?? 0
                };

            } catch (error) {
                console.warn("Live route check failed:", routeId, error);

                routeLiveCache[routeId] = {
                    loading: false,
                    error: true,
                    totalVehicles: 0,
                    liveVehicles: 0,
                    exactScheduledCount: 0,
                    vehicles: []
                };
            }
        }));

        renderJourneys();
    }

    document.querySelectorAll(".filter-btn").forEach(button => {
        button.addEventListener("click", () => {
            currentFilter = button.dataset.filter;

            document.querySelectorAll(".filter-btn").forEach(btn => {
                btn.classList.toggle("active", btn === button);
            });

            renderJourneys();
        });
    });

    document.getElementById("sortSelect").addEventListener("change", event => {
        currentSort = event.target.value;
        renderJourneys();
    });

    function getBadge(transfers) {
        if (transfers === 0) {
            return '<span class="journey-badge direct-badge"><i class="bi bi-check-circle me-1"></i> DIRECT JOURNEY</span>';
        }

        if (transfers === 1) {
            return '<span class="journey-badge one-badge"><i class="bi bi-arrow-left-right me-1"></i> 1 TRANSFER</span>';
        }

        return '<span class="journey-badge two-badge"><i class="bi bi-signpost-split me-1"></i> 2 TRANSFERS</span>';
    }

    function renderJourneys() {
        const results = document.getElementById("journeyResults");

        let journeys = [...allJourneys];

        if (currentFilter !== "all") {
            journeys = journeys.filter(
                journey => journey.transfers === Number(currentFilter)
            );
        }

        journeys.sort((a, b) => {
            if (currentSort === "easiest") {
                return (a.ranking?.easiestScore ?? 999999) -
                    (b.ranking?.easiestScore ?? 999999) ||
                    a.durationMinutes - b.durationMinutes;
            }

            return a.durationMinutes - b.durationMinutes;
        });

        currentRenderedJourneys = journeys;

        if (!journeys.length) {
            results.innerHTML = `
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-search"></i>
                    </div>
                    <h5>No journeys in this category</h5>
                    <p class="muted mb-0">
                        Try another journey type or search different stops.
                    </p>
                </div>
            `;
            return;
        }

        results.innerHTML = journeys.map((journey, index) => {
            const alternatives = journey.alternativeDepartures || [];
            const cardId = "journey-" + index;

            return `
                <div class="journey-card">
                    <div class="card-main">

                        <div class="journey-top">
                            <div>
                                ${getBadge(journey.transfers)}
                                <div class="route-name">
                                    <i class="bi bi-bus-front me-1"></i>
                                    ${journey.legs?.length || 0} bus leg(s)
                                </div>
                                <div class="duration mt-2">
                                    <i class="bi bi-clock me-1"></i>
                                    ${alternatives.length} alternative departure(s)
                                </div>
                            </div>

                            <div class="total-time">
                                <div class="time-value">
                                    ${escapeHTML(journey.durationMinutes)} min
                                </div>
                                <div class="duration">Total journey time</div>
                            </div>
                        </div>

                        <div class="row align-items-center g-2">
                            <div class="col-4">
                                <div class="time-value">
                                    ${escapeHTML(journey.departureTime)}
                                </div>
                                <div class="duration text-truncate mt-1">
                                    ${escapeHTML(journey.legs?.[0]?.from?.stopName)}
                                </div>
                                <div class="duration mt-1">DEPARTURE</div>
                            </div>

                            <div class="col-4">
                                <div class="d-flex align-items-center">
                                    <span class="route-point"></span>
                                    <div class="route-line"></div>
                                    <span class="route-point end"></span>
                                </div>
                                <div class="duration text-center mt-3">
                                    ${journey.transfers} transfer(s)
                                </div>
                            </div>

                            <div class="col-4 text-end">
                                <div class="time-value">
                                    ${escapeHTML(journey.arrivalTime)}
                                </div>
                                <div class="duration text-truncate mt-1">
                                    ${escapeHTML(journey.legs?.at(-1)?.to?.stopName)}
                                </div>
                                <div class="duration mt-1">ARRIVAL</div>
                            </div>
                        </div>

                        <div class="action-row">
                            <div class="small muted">
                                <i class="bi bi-hourglass-split me-1"></i>
                                Waiting time:
                                <strong class="text-dark">
                                    ${escapeHTML(journey.waitingMinutes ?? 0)} min
                                </strong>
                            </div>

                            <div class="d-flex gap-2 flex-wrap">
                                <button class="detail-btn"
                                    onclick="toggleDetails('${cardId}')">
                                    <i class="bi bi-list-ul me-1"></i>
                                    Journey details ↓
                                </button>

                                <button class="map-btn"
                                    onclick="viewJourneyOnMap(${index})">
                                    <i class="bi bi-map me-1"></i>
                                    View on Map
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="journey-details" id="${cardId}">
                        <div class="details-heading">
                            <i class="bi bi-signpost-split me-1"></i>
                            JOURNEY BREAKDOWN
                        </div>
                        ${renderLegs(journey.legs || [])}
                        ${renderAlternatives(alternatives)}
                    </div>
                </div>
            `;
        }).join("");
    }

    function renderLiveStatus(leg) {
        const routeId = String(leg.routeId || "").trim();

        if (!routeId) {
            return `
                <div class="live-status">
                    <div>
                        <div class="live-status-title">Live GPS status</div>
                        <div class="live-status-detail">Route ID unavailable</div>
                    </div>
                    <span class="live-pill live-warning">NOT AVAILABLE</span>
                </div>
            `;
        }

        const status = routeLiveCache[routeId];

        if (!status || status.loading) {
            return `
                <div class="live-status">
                    <div>
                        <div class="live-status-title">
                            Route ${escapeHTML(routeId)} · Live GPS
                        </div>
                        <div class="live-status-detail">
                            Checking current vehicle feed...
                        </div>
                    </div>
                    <span class="live-pill live-pending">CHECKING</span>
                </div>
            `;
        }

        if (status.error) {
            return `
                <div class="live-status">
                    <div>
                        <div class="live-status-title">
                            Route ${escapeHTML(routeId)} · Live GPS
                        </div>
                        <div class="live-status-detail">
                            Unable to retrieve live route data
                        </div>
                    </div>
                    <span class="live-pill live-warning">UNAVAILABLE</span>
                </div>
            `;
        }

        if (status.liveVehicles > 0 && status.exactScheduledCount > 0) {
            return `
                <div class="live-status">
                    <div>
                        <div class="live-status-title">
                            Route ${escapeHTML(routeId)} · ${status.liveVehicles} live vehicle(s)
                        </div>
                        <div class="live-status-detail">
                            ${status.exactScheduledCount} exact scheduled trip match(es) reported
                        </div>
                    </div>
                    <span class="live-pill live-yes">SCHEDULED MATCH</span>
                </div>
            `;
        }

        if (status.liveVehicles > 0) {
            return `
                <div class="live-status">
                    <div>
                        <div class="live-status-title">
                            Route ${escapeHTML(routeId)} · ${status.liveVehicles} live vehicle(s)
                        </div>
                        <div class="live-status-detail">
                            GPS available on this route; selected scheduled trip is not confirmed
                        </div>
                    </div>
                    <span class="live-pill live-warning">VERIFY TRIP</span>
                </div>
            `;
        }

        return `
            <div class="live-status">
                <div>
                    <div class="live-status-title">
                        Route ${escapeHTML(routeId)} · No live vehicles found
                    </div>
                    <div class="live-status-detail">
                        No fresh GPS vehicle in the current route snapshot
                    </div>
                </div>
                <span class="live-pill live-no">NO LIVE GPS</span>
            </div>
        `;
    }

    function viewJourneyOnMap(index) {
        const journey = currentRenderedJourneys[index];

        if (!journey || !Array.isArray(journey.legs) || !journey.legs.length) {
            alert("Journey details are unavailable. Please search again.");
            return;
        }

        const selectedJourney = {
            journey: journey,
            travelDate: travelDate.value,
            from: {
                stopId: selectedFrom?.stopId,
                stopName: selectedFrom?.stopName
            },
            to: {
                stopId: selectedTo?.stopId,
                stopName: selectedTo?.stopName
            },
            selectedAt: new Date().toISOString()
        };

        try {
            sessionStorage.setItem(
                "transportStackSelectedJourney",
                JSON.stringify(selectedJourney)
            );

            window.location.href = "/live-map?mode=journey";

        } catch (error) {
            console.error("Unable to save selected journey:", error);
            alert("Unable to open this journey on the map. Please try again.");
        }
    }

    function renderLegs(legs) {
        return legs.map((leg, index) => {
            const isLast = index === legs.length - 1;
            const fromName = leg.from?.stopName || "Unknown stop";
            const toName = leg.to?.stopName || "Unknown stop";
            const nextLeg = legs[index + 1];

            let transferNote = "";

            if (!isLast && nextLeg) {
                const nextBoardingStop = nextLeg.from?.stopName || "Unknown stop";

                const sameStop =
                    (leg.to?.stopId && nextLeg.from?.stopId)
                        ? String(leg.to.stopId) === String(nextLeg.from.stopId)
                        : normalizeText(toName) === normalizeText(nextBoardingStop);

                if (sameStop) {
                    transferNote = `
                        <div class="transfer-note">
                            <i class="bi bi-arrow-left-right me-1"></i>
                            Change bus at:
                            <strong>${escapeHTML(toName)}</strong>
                        </div>
                    `;
                } else {
                    transferNote = `
                        <div class="transfer-note">
                            <i class="bi bi-arrow-left-right me-1"></i>
                            Get off at:
                            <strong>${escapeHTML(toName)}</strong>
                            <br>
                            Next bus boards at:
                            <strong>${escapeHTML(nextBoardingStop)}</strong>
                        </div>
                    `;
                }
            }

            return `
                <div class="leg">
                    <div class="leg-title">
                        <i class="bi bi-bus-front me-1"></i>
                        Bus ${index + 1}:
                        ${escapeHTML(
                            leg.routeName ||
                            leg.routeShortName ||
                            leg.routeId ||
                            "Bus"
                        )}
                    </div>

                    <div class="leg-meta">
                        Route ID: <strong>${escapeHTML(leg.routeId || "N/A")}</strong><br>

                        <strong>From:</strong> ${escapeHTML(fromName)}<br>

                        <strong>To:</strong> ${escapeHTML(toName)}<br>

                        Departure:
                        <strong>${escapeHTML(leg.departureTime || "N/A")}</strong>
                        · Arrival:
                        <strong>${escapeHTML(leg.arrivalTime || "N/A")}</strong><br>

                        Leg duration:
                        ${escapeHTML(leg.durationMinutes ?? "N/A")} min<br>

                        <strong>Bus direction:</strong>
                        ${escapeHTML(leg.tripHeadsign || "Not specified")}
                    </div>

                    ${renderLiveStatus(leg)}
                </div>

                ${transferNote}
            `;
        }).join("");
    }

    function renderAlternatives(alternatives) {
        if (!alternatives.length) {
            return `
                <div class="small muted mt-2">
                    No alternative departures available for this journey.
                </div>
            `;
        }

        return `
            <div class="mt-3">
                <div class="details-heading">
                    <i class="bi bi-clock-history me-1"></i>
                    ALTERNATIVE DEPARTURES (${alternatives.length})
                </div>

                ${alternatives.map(alternative => `
                    <div class="alternative">
                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <strong>
                                ${escapeHTML(alternative.departureTime)}
                                → ${escapeHTML(alternative.arrivalTime)}
                            </strong>

                            <span class="small fw-bold">
                                ${escapeHTML(alternative.durationMinutes)} min
                            </span>
                        </div>

                        <small>
                            ${escapeHTML((alternative.tripIds || []).join(" · "))}
                            · Waiting: ${escapeHTML(alternative.waitingMinutes ?? 0)} min
                        </small>
                    </div>
                `).join("")}
            </div>
        `;
    }

    function toggleDetails(id) {
        document.getElementById(id)?.classList.toggle("open");
    }
</script>

</body>
</html>
